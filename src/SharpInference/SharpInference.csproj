<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Meta-package. Installing `SharpInference` brings in all 8 library packages
    (Core, Cpu, Vulkan, Cuda, Engine, Pipeline, TurboQuant, Diffusion) via
    transitive NuGet dependencies declared from the ProjectReferences below.
  -->

  <PropertyGroup>
    <PackageId>SharpInference</PackageId>
    <IsPackable>true</IsPackable>
    <Description>High-performance LLM inference engine and image generation pipeline in C# / .NET. Reads GGUF models and runs transformer inference on CPU (AVX2/AVX-512 SIMD), Vulkan, and CUDA. Includes Z-Image-Turbo text-to-image and Real-ESRGAN upscaling. NativeAOT-friendly. This meta-package pulls in every SharpInference.* sub-package.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- No code here; this project exists only to bundle the sub-packages. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.Cpu\SharpInference.Cpu.csproj" />
    <ProjectReference Include="..\SharpInference.Vulkan\SharpInference.Vulkan.csproj" />
    <ProjectReference Include="..\SharpInference.Cuda\SharpInference.Cuda.csproj" />
    <ProjectReference Include="..\SharpInference.Engine\SharpInference.Engine.csproj" />
    <ProjectReference Include="..\SharpInference.Pipeline\SharpInference.Pipeline.csproj" />
    <ProjectReference Include="..\SharpInference.TurboQuant\SharpInference.TurboQuant.csproj" />
    <ProjectReference Include="..\SharpInference.Diffusion\SharpInference.Diffusion.csproj" />
  </ItemGroup>

</Project>
