<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `SharpInference` is the one library NuGet. It bundles every SharpInference.*
    assembly (Core, Cpu, Vulkan, Cuda, Engine, Pipeline, TurboQuant, Diffusion)
    so a single `dotnet add package SharpInference` brings in the whole stack.
    The CLI ships separately as `SharpInference.Cli` (dotnet tool); nothing else
    is published.
  -->

  <PropertyGroup>
    <PackageId>SharpInference</PackageId>
    <IsPackable>true</IsPackable>
    <Description>High-performance LLM inference engine and image generation pipeline in C# / .NET. Reads GGUF models and runs transformer inference on CPU (AVX2/AVX-512 SIMD), Vulkan, and CUDA. Includes Z-Image-Turbo text-to-image and Real-ESRGAN upscaling. NativeAOT-friendly.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Custom target below routes referenced project outputs into the package.
      BuildOutputInPackage is the canonical channel: .dll goes to the main .nupkg
      and matching .pdb goes to the .snupkg automatically. This requires
      IncludeBuildOutput=true (the default), so the meta-project's own (tiny,
      ~5 KB) stub SharpInference.dll also ships — that's standard for meta-packages.
    -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceOutputs</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Ship the native AVX-512-VNNI helper (native/cpu_vnni/sharpi_cpu_vnni.dll, built by
    build-vnni.ps1 with clang-cl) as a win-x64 native runtime asset so a win-x64 library
    consumer gets it next to the assemblies and Q8VnniInterop loads it by name. The custom
    IncludeProjectReferenceOutputs target above only routes managed .dll/.xml/.pdb, so the
    native DLL must be added here explicitly. Only packs when it was actually built (clang/
    VS present) — otherwise the package omits it and the managed AVX2 path runs. Linux and
    other RIDs get nothing (the project has no Linux native build for any dependency).
    NOTE: the release workflow must run on Windows so build-vnni.ps1 produces this DLL.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\cpu_vnni\sharpi_cpu_vnni.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\cpu_vnni\sharpi_cpu_vnni.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
  </ItemGroup>

  <!-- PrivateAssets=all stops the referenced projects from being listed as nuget
       dependencies (their DLLs ride inside this package instead). The third-party
       package deps used by those libraries are re-declared below. -->
  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Cpu\SharpInference.Cpu.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Vulkan\SharpInference.Vulkan.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Cuda\SharpInference.Cuda.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Engine\SharpInference.Engine.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Vision\SharpInference.Vision.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Pipeline\SharpInference.Pipeline.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.TurboQuant\SharpInference.TurboQuant.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SharpInference.Diffusion\SharpInference.Diffusion.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="*" />
    <PackageReference Include="Vortice.Vulkan" Version="*" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.5" />
  </ItemGroup>

  <Target Name="IncludeProjectReferenceOutputs" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' AND ('%(Extension)' == '.dll' OR '%(Extension)' == '.xml')" />
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths -> '%(RootDir)%(Directory)%(Filename).pdb')"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' AND '%(Extension)' == '.dll' AND Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

</Project>
