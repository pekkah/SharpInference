<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Vulkan compute backend for SharpInference: cross-vendor GPU inference (AMD / Intel / NVIDIA) using SPIR-V compute shaders via Vortice.Vulkan.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.Cpu\SharpInference.Cpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SpirvGen (the dev-only SPIR-V table generator) reflects internal Shaders consts and
         calls internal ShaderCompiler.Compile/StableHash; the test project asserts the table
         covers every shader and that the precompiled path is taken at runtime. -->
    <InternalsVisibleTo Include="SpirvGen" />
    <InternalsVisibleTo Include="SharpInference.Tests.ForwardPass" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Vulkan" Version="*" />
  </ItemGroup>

</Project>
