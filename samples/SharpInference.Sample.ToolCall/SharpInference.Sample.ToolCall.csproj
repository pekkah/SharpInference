<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpInference.Sample.ToolCall</RootNamespace>
    <AssemblyName>sharpi-sample-toolcall</AssemblyName>
  </PropertyGroup>

  <!-- Reference only what the sample uses:
       - Core    : GgufModel, GgufTokenizer, JinjaChatTemplate, ModelHyperparams
       - Cpu     : CpuBackend (default, no GPU drivers required)
       - Cuda    : CudaBackend, CudaForwardPass, CudaHybridForwardPass
       - Engine  : ForwardPass, SamplingParams, InferenceEngine, TierPlanner, HardwareProfile -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\..\src\SharpInference.Cpu\SharpInference.Cpu.csproj" />
    <ProjectReference Include="..\..\src\SharpInference.Cuda\SharpInference.Cuda.csproj" />
    <ProjectReference Include="..\..\src\SharpInference.Engine\SharpInference.Engine.csproj" />
  </ItemGroup>

</Project>
